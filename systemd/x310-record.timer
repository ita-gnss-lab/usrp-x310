[Unit]
Description=Trigger x310-record.service at 16:00 and 17:00 local time

[Timer]
OnCalendar=*-*-* 16:00:00
OnCalendar=*-*-* 17:00:00
AccuracySec=1min
# If the host was off/asleep at a scheduled time, run once at next boot --
# x310-record.sh's own window check still blocks it if that catch-up lands
# outside [16:00, 18:00).
Persistent=true

[Install]
WantedBy=timers.target
