[Unit]
Description=Sense the USRP X310 and record every 15 min between 16:00 and 18:00 local time

[Timer]
# 16:00, 16:15, 16:30, ..., 17:45 -- x310-record.sh is what actually decides
# whether to record (device present? under the daily limit? 30 min since
# the first recording?), this just bounds when it's even allowed to try.
OnCalendar=*-*-* 16..17:0/15:00
AccuracySec=30sec
Persistent=false

[Install]
WantedBy=timers.target
