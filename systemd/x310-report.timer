[Unit]
Description=Trigger x310-report.service every 15 days since it last ran

[Timer]
# Relative, not calendar-based: fires exactly 15 days after the previous
# run (send_whatsapp_msg.py's own "since the last report" window matches this
# exactly), rather than approximating with day-of-month arithmetic.
OnBootSec=15min
OnUnitActiveSec=15d
Persistent=true

[Install]
WantedBy=timers.target
